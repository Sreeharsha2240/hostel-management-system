# Copy this file to .env and fill in your own values. Never commit .env.

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Keep the single quotes so special characters are read literally.
DJANGO_SECRET_KEY='replace-with-a-generated-key'
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL 8 database (see README > Database setup)
DB_NAME=hms
DB_USER=hms_user
DB_PASSWORD='replace-with-the-hms_user-password'
DB_HOST=localhost
DB_PORT=3306
DJANGO_SESSION_COOKIE_SECURE=False
